---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title={`페이지를 찾을 수 없습니다 | ${profile.name} 포트폴리오`}
  description="요청하신 페이지를 찾을 수 없습니다."
  noindex
>
  <Nav />
  <main class="pt-nav">
    <div class="mx-auto flex max-w-content flex-col items-center px-6 py-section text-center">
      <p class="text-7xl font-bold tracking-tight text-accent md:text-8xl">404</p>
      <h1 class="mt-6 text-2xl font-bold md:text-3xl">페이지를 찾을 수 없습니다</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
        주소가 잘못되었거나 페이지가 이동·삭제되었을 수 있습니다.
      </p>
      <a
        href="/"
        class="mt-10 rounded-lg bg-accent px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-hover"
      >
        메인으로 돌아가기
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
