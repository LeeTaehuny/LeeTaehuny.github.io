---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import CompanyProjectLayout from '../../layouts/CompanyProjectLayout.astro';
import PersonalProjectLayout from '../../layouts/PersonalProjectLayout.astro';
import { mdxComponents } from '../../components/mdx';
import { getProjects } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
---

{project.data.type === 'company' ? (
  <CompanyProjectLayout project={project} prev={prev} next={next}>
    <Content components={mdxComponents} />
  </CompanyProjectLayout>
) : (
  <PersonalProjectLayout project={project} prev={prev} next={next} headings={headings}>
    <Content components={mdxComponents} />
  </PersonalProjectLayout>
)}
