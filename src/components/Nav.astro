---
import { profile } from '../data/profile';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#tech-stack', label: 'Tech Stack' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border bg-bg/90 backdrop-blur">
  <nav class="mx-auto flex h-nav max-w-content items-center justify-between px-6">
    <a href="/" class="text-lg font-bold">{profile.name}</a>

    <ul class="hidden gap-8 text-sm font-medium text-muted md:flex">
      {links.map((link) => (
        <li><a href={link.href} class="transition-colors hover:text-accent">{link.label}</a></li>
      ))}
    </ul>

    <button
      type="button"
      id="nav-toggle"
      class="-mr-2 rounded p-2 text-text md:hidden"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <ul id="nav-menu" class="hidden border-t border-border bg-bg px-6 py-2 md:hidden">
    {links.map((link) => (
      <li><a href={link.href} class="block py-3 font-medium text-muted hover:text-accent">{link.label}</a></li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    };

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>
