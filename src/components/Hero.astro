---
import { profile } from '../data/profile';
---

<section id="top" class="pt-nav">
  <div class="mx-auto flex max-w-content flex-col items-center px-6 py-section text-center">
    <h1 class="text-5xl font-bold tracking-tight md:text-6xl">{profile.name}</h1>
    <p class="mt-4 text-xl font-semibold text-accent md:text-2xl">{profile.role}</p>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{profile.tagline}</p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-accent px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-hover"
      >
        GitHub
      </a>
      <a
        href={profile.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-accent px-6 py-3 font-semibold text-accent transition-colors hover:bg-accent-soft"
      >
        이력서 PDF
      </a>
    </div>
  </div>
</section>
