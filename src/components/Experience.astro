---
import Section from './Section.astro';
import { experiences } from '../data/profile';
---

<Section id="experience" title="Experience">
  <ol class="relative ml-2 border-l-2 border-border">
    {experiences.map((exp) => (
      <li class="relative pb-10 pl-8 last:pb-0">
        <span class="absolute -left-2.25 top-1.5 size-4 rounded-full border-4 border-bg bg-accent" aria-hidden="true"></span>
        <p class="text-sm font-medium text-muted">{exp.period}</p>
        <h3 class="mt-1 text-xl font-bold">{exp.company}</h3>
        <p class="font-medium text-accent">{exp.position}</p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-muted">
          {exp.tasks.map((task) => (
            <li>
              <strong class="font-semibold text-text">{task.title}</strong>: {task.detail}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Section>
