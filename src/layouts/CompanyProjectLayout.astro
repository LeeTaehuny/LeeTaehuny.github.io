---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectHeader from '../components/project/ProjectHeader.astro';
import ProjectInfo from '../components/project/ProjectInfo.astro';
import ProjectPager from '../components/project/ProjectPager.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
---

<BaseLayout title={`${project.data.title} | 포트폴리오`} description={project.data.summary}>
  <Nav />
  <main class="pt-nav">
    <article class="mx-auto max-w-3xl px-6 py-section">
      <ProjectHeader project={project} />
      <div class="mt-12">
        <ProjectInfo project={project} />
      </div>
      <div class="prose-content mt-12">
        <slot />
      </div>
      <ProjectPager prev={prev} next={next} />
    </article>
  </main>
  <Footer />
</BaseLayout>
